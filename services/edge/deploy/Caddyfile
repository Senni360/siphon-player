# The site block for the container deployment. Caddy and encore-edge share the
# Docker network named in deploy/docker-compose.yml, so Caddy proxies to the
# container name rather than a loopback port.
#
# If Caddy already runs on this host, append this block to its existing
# Caddyfile in place. Do not replace or rename that file: it is a single-file
# bind mount, and a rename leaves the container reading the old inode. Validate
# the whole file in a throwaway container, then `caddy reload`; never restart
# Caddy or any other container. See README.md.
#
# Do not enable Caddy's `encode` directive for this host: media responses must
# stay uncompressed and Caddy must not touch Content-Length or ETag.
edge.encore.senni.dev {
	request_body {
		max_size 1GB
	}

	reverse_proxy encore-edge:8787 {
		# WebSocket relays and long media reads must not be buffered.
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	# Access logs would contain media tokens and query strings. Discard them.
	log {
		output discard
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
