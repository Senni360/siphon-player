[Unit]
Description=Encore edge service (phone backend)
Documentation=https://github.com/siphon-app/siphon/tree/main/services/edge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=encore-edge
Group=encore-edge
WorkingDirectory=/opt/encore-edge
ExecStart=/usr/bin/node src/index.mjs
EnvironmentFile=/etc/encore-edge/edge.env
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0027

# The only writable place is the state directory. Cache, uploads and sync all
# live below it; systemd's own runtime is read-only to the service.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/encore-edge
StateDirectory=encore-edge
StateDirectoryMode=0750
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
