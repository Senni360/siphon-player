{
  "functions": { "api/index.ts": { "includeFiles": "assets/**", "maxDuration": 300 } },
  "rewrites": [
    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "encore.senni.dev" }], "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/", "destination": "/api" },
    { "source": "/download", "destination": "/api" },
    { "source": "/privacy", "destination": "/api" },
    { "source": "/party/(.*)", "destination": "/api" }
  ]
}
