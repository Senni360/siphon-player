#: src/util.rs:262
msgid "Good morning"
msgstr "Buongiorno"

#: src/util.rs:263
msgid "Good afternoon"
msgstr "Buon pomeriggio"

#: src/util.rs:264
msgid "Good evening"
msgstr "Buonasera"

#: src/window.rs:12
msgid "On Wayland, use your desktop's Keep Above shortcut or window rule."
msgstr ""
"Su Wayland, usa la scorciatoia o la regola della finestra “Mantieni sopra” "
"del tuo desktop."

#: src/window.rs:31
msgid "Siphon cannot open its window"
msgstr "Siphon non riesce ad aprire la finestra"

#: src/window.rs:34
msgid "Open page"
msgstr "Apri la pagina"

#: src/window.rs:51
msgid ""
"On Windows on ARM, the OpenGL that Siphon draws with comes from Microsoft's "
"OpenCL, OpenGL & Vulkan Compatibility Pack. Open its Microsoft Store page to "
"install or repair it?"
msgstr ""
"Su Windows on ARM, l’OpenGL con cui Siphon disegna proviene dall’OpenCL, "
"OpenGL & Vulkan Compatibility Pack di Microsoft. Aprire la sua pagina nel "
"Microsoft Store per installarlo o ripararlo?"

#. Translators: Keep {url} exactly as written. It becomes the address
#. of the Siphon download page.
#: src/window.rs:58
#, rust-format
msgid ""
"Siphon needs a graphics driver with OpenGL 2.0 or newer, and this PC or "
"virtual machine does not provide one. Install the graphics driver, or turn "
"on GPU acceleration for the virtual machine. Open {url} to read more?"
msgstr ""
"Siphon ha bisogno di un driver grafico con OpenGL 2.0 o successivo, e questo "
"PC o macchina virtuale non lo fornisce. Installa il driver grafico, oppure "
"attiva l’accelerazione GPU della macchina virtuale. Aprire {url} per saperne "
"di più?"

#: src/soundcloud/connect.rs:23
msgid "SoundCloud could not find that profile."
msgstr "SoundCloud non è riuscito a trovare quel profilo."

#: src/soundcloud/connect.rs:27
msgid ""
"SoundCloud rejected this session. Paste a current session token or connect "
"by profile."
msgstr ""
"SoundCloud ha rifiutato questa sessione. Incolla un token della sessione "
"corrente o connettiti per profilo."

#: src/soundcloud/connect.rs:33
msgid "Could not update the protected SoundCloud session."
msgstr "Impossibile aggiornare la sessione protetta di SoundCloud."

#: src/soundcloud/connect.rs:35
msgid "SoundCloud returned an invalid profile."
msgstr "SoundCloud ha restituito un profilo non valido."

#: src/soundcloud/connect.rs:38
msgid "The saved SoundCloud session is invalid. Connect again."
msgstr "La sessione SoundCloud salvata non è valida. Connettiti di nuovo."

#: src/soundcloud/connect.rs:42
msgid ""
"The saved SoundCloud session belongs to a different account. Connect again."
msgstr ""
"La sessione SoundCloud salvata appartiene a un account diverso. Connettiti "
"di nuovo."

#: src/ui/soundcloud.rs:16 src/app/hybrid.rs:793 src/app/hybrid.rs:898
msgid "SoundCloud Likes"
msgstr "Mi piace di SoundCloud"

#: src/ui/soundcloud.rs:19
msgid "Connect a SoundCloud profile to see its likes."
msgstr "Collega un profilo SoundCloud per vedere i suoi Mi piace."

#: src/app/hybrid.rs:953
msgid "Mixed playback"
msgstr "Riproduzione mista"

#: src/app/hybrid.rs:1048
msgid ""
"SoundCloud songs cannot be queued on another device. Start mixed playback on "
"this computer first."
msgstr ""
"I brani SoundCloud non possono essere messi in coda su un altro dispositivo. "
"Avviare prima la riproduzione mista su questo computer."

#: src/app/hybrid.rs:1056
msgid ""
"Start a mixed playlist to keep its full shuffle order when adding SoundCloud"
msgstr ""
"Avvia una playlist mista per mantenere l'ordine casuale completo quando "
"aggiungi SoundCloud"

#: src/app/hybrid.rs:1085
msgid ""
"Open the complete playlist before adding SoundCloud, or start a mixed "
"playlist"
msgstr ""
"Apri la playlist completa prima di aggiungere SoundCloud o avvia una "
"playlist mista"

#: src/app/hybrid.rs:1106
msgid ""
"Start a mixed playlist to keep the current song and its complete queue when "
"adding SoundCloud"
msgstr ""
"Avvia una playlist mista per mantenere il brano corrente e la sua coda "
"completa quando aggiungi SoundCloud"

#: src/app/playlist_sources.rs:129 src/app/playlist_sources.rs:394
msgid "Playlist additions could not be loaded. Your saved file has been kept."
msgstr ""
"Impossibile caricare le aggiunte alla playlist. Il tuo file salvato è stato "
"conservato."

#: src/app/playlist_sources.rs:153
msgid "Adding SoundCloud tracks…"
msgstr "Aggiunta di tracce SoundCloud…"

#. Translators: {count} songs were added to playlist {name}.
#: src/app/playlist_sources.rs:207
#, rust-format
msgid "Added {count} SoundCloud track to {name}"
msgid_plural "Added {count} SoundCloud tracks to {name}"
msgstr[0] "{count} brano SoundCloud aggiunto a {name}"
msgstr[1] "{count} brani SoundCloud aggiunti a {name}"

#: src/app/playlist_sources.rs:241
msgid "Could not add the SoundCloud playlist. Try again."
msgstr "Impossibile aggiungere la playlist SoundCloud. Riprova."

#: src/app/playlist_sources.rs:295
msgid "Could not save mixed playlists. Try again."
msgstr "Impossibile salvare playlist miste. Riprova."

#: src/app/playlist_sources.rs:311
msgid "Could not save playlist additions. Try again."
msgstr "Impossibile salvare le aggiunte alla playlist. Riprova."

#: src/app/playlist_sources.rs:367 src/app/playlist_sources.rs:526
#: src/app/playlist_sources.rs:540
msgid "Mixed playlists could not be loaded. Your saved file has been kept."
msgstr ""
"Impossibile caricare le playlist miste. Il tuo file salvato è stato "
"conservato."

#: src/app/playlist_sources.rs:561
#, rust-format
msgid "{name} (copy)"
msgstr "{name} (copia)"

