msgstr "Kesintisiz çalma"

#: src/ui/settings.rs:622
msgid "Keep music playing when the window closes"
msgstr "Pencere kapandığında müzik çalmaya devam etsin"

#: src/ui/settings.rs:623
msgid "Automatic update checks"
msgstr "Otomatik güncelleme denetimleri"

#: src/ui/settings.rs:624
